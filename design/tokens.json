{
  "$schema": "tokens.schema.json",
  "schemaVersion": 1,
  "toolkitVersion": "0.1.0",
  "name": "Calm Dark",
  "units": {
    "length": "logical_design_unit",
    "fontSize": "logical_type_unit",
    "duration": "millisecond",
    "referenceAdapter": {
      "id": "fabric-modernui",
      "lengthMapping": "1 design unit = 1 ModernUI dp; convert using the host context density.",
      "fontMapping": "1 type unit = 1 ModernUI sp; let the text API apply scaled density.",
      "pixelPolicy": "The renderer handles framebuffer pixels. Never apply Minecraft GUI scale a second time."
    }
  },
  "colors": {
    "background": "#101419",
    "panel": "#191F27",
    "raised": "#232C37",
    "border": "#6E7D90",
    "focus": "#A9CBFF",
    "textPrimary": "#F3F5F7",
    "textSecondary": "#AAB6C5",
    "textDisabled": "#94A1B3",
    "textOnAccent": "#12284A",
    "accent": "#8BB6FF",
    "accentHover": "#A4C6FF",
    "accentPressed": "#70A0EB",
    "danger": "#FFB4AB",
    "dangerSurface": "#472529",
    "success": "#94D6AD",
    "successSurface": "#1B392B",
    "scrim": "#000000"
  },
  "typography": {
    "font": {
      "family": "Inter",
      "style": "Regular",
      "weight": 400,
      "release": "4.1",
      "internalVersion": "Version 4.001;git-9221beed3",
      "file": "fonts/Inter-Regular.ttf",
      "license": "OFL-1.1",
      "licenseFile": "fonts/OFL.txt",
      "sha256": "40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82",
      "licenseSha256": "262481e844521b326f5ecd053e59b98c8b2da78c8ee1bdbb6e8174305e54935a",
      "source": "https://github.com/rsms/inter/releases/tag/v4.1",
      "fallbackPolicy": "Keep the renderer's Unicode fallback enabled; test unsupported scripts on each supported runtime."
    },
    "sizes": {
      "caption": 10,
      "body": 12,
      "section": 16,
      "title": 22
    },
    "lineHeightMultiplier": 1.35
  },
  "spacing": {"xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24},
  "radii": {"control": 6, "panel": 10, "popup": 10, "pill": 999},
  "metrics": {
    "controlHeight": 32,
    "compactControlHeight": 28,
    "focusWidth": 2,
    "borderWidth": 1,
    "safeInset": 16,
    "sidebarWidth": 132,
    "sidebarBreakpoint": 600,
    "maxContentWidth": 960,
    "minViewportWidth": 320,
    "minViewportHeight": 240,
    "tooltipMaxWidth": 240,
    "toastMaxWidth": 320,
    "sliderTrackHeight": 4,
    "toggleWidth": 40,
    "toggleHeight": 22
  },
  "effects": {
    "scrimOpacity": 0.48,
    "blurEnabledDefault": false,
    "shadowEnabledDefault": false
  },
  "motion": {
    "hover": {"durationMs": 100, "easing": "easeOutCubic"},
    "press": {"durationMs": 70, "easing": "easeOutCubic", "scaleFrom": 1, "scaleTo": 0.98},
    "release": {"durationMs": 110, "easing": "easeOutCubic", "scaleTo": 1},
    "screenOpen": {"durationMs": 220, "easing": "easeOutCubic", "translateY": 8, "opacityFrom": 0, "opacityTo": 1},
    "screenClose": {"durationMs": 140, "easing": "easeInCubic", "translateY": 4, "opacityFrom": 1, "opacityTo": 0},
    "popupOpen": {"durationMs": 160, "easing": "easeOutCubic", "translateY": 4, "opacityFrom": 0, "opacityTo": 1},
    "popupClose": {"durationMs": 120, "easing": "easeInCubic", "translateY": 4, "opacityFrom": 1, "opacityTo": 0},
    "toastOpen": {"durationMs": 220, "easing": "easeOutCubic", "translateY": 8, "opacityFrom": 0, "opacityTo": 1},
    "toastClose": {"durationMs": 160, "easing": "easeInCubic", "translateY": 4, "opacityFrom": 1, "opacityTo": 0},
    "tab": {"durationMs": 140, "easing": "easeOutCubic", "opacityFrom": 0, "opacityTo": 1},
    "tooltipDelayMs": 500,
    "toastVisibleMs": 4000,
    "reducedMotion": {"enabledDefault": false, "durationMs": 0, "spatialMotion": false, "springs": false}
  },
  "contrastPairs": [
    {"foreground": "textPrimary", "background": "background", "minimum": 4.5, "purpose": "Body text on the screen"},
    {"foreground": "textPrimary", "background": "panel", "minimum": 4.5, "purpose": "Panel labels"},
    {"foreground": "textPrimary", "background": "raised", "minimum": 4.5, "purpose": "Hovered control labels"},
    {"foreground": "textSecondary", "background": "raised", "minimum": 4.5, "purpose": "Helper text on the brightest base surface"},
    {"foreground": "textDisabled", "background": "raised", "minimum": 4.5, "purpose": "Readable disabled labels"},
    {"foreground": "textOnAccent", "background": "accent", "minimum": 4.5, "purpose": "Primary button label"},
    {"foreground": "textOnAccent", "background": "accentHover", "minimum": 4.5, "purpose": "Hovered primary label"},
    {"foreground": "textOnAccent", "background": "accentPressed", "minimum": 4.5, "purpose": "Pressed primary label"},
    {"foreground": "border", "background": "raised", "minimum": 3, "purpose": "Control boundary and unchecked track"},
    {"foreground": "focus", "background": "raised", "minimum": 3, "purpose": "Keyboard focus ring"},
    {"foreground": "textPrimary", "background": "border", "minimum": 3, "purpose": "Toggle thumb against unchecked track"},
    {"foreground": "danger", "background": "dangerSurface", "minimum": 4.5, "purpose": "Error message"},
    {"foreground": "success", "background": "successSurface", "minimum": 4.5, "purpose": "Success toast"}
  ]
}
